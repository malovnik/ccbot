# === Required ===

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USERS=your_telegram_user_id

# === Optional: tmux ===

# tmux session name (default: ccbot)
# TMUX_SESSION_NAME=ccbot

# Claude command to run in new windows (default: claude)
# CLAUDE_COMMAND=claude

# === Optional: polling ===

# Monitor polling interval in seconds (default: 2.0, minimum: 0.5)
# MONITOR_POLL_INTERVAL=3.0

# === Optional: voice transcription ===

# Deepgram API key for voice message transcription
# Get yours at https://developers.deepgram.com
# DEEPGRAM_API_KEY=your_deepgram_key_here

# === Optional: security ===

# Restrict directory browser and file sending to these paths
# Comma-separated, default: ~ (home directory)
# SECURITY: Set to your project directories only
# CCBOT_ALLOWED_ROOTS=~/Documents/Dev,~/projects

# === Optional: output ===

# Filter tool spam from Telegram (default: true)
# WARNING: Setting to false forwards ALL tool output including
# Bash results to Telegram, which may expose secrets
# CCBOT_CLEAN_OUTPUT=true

# Echo user messages back with prefix (default: false)
# CCBOT_SHOW_USER_MESSAGES=false

# Show tool call notifications in Telegram (default: true)
# Set to false to only see text responses, thinking, and interactive prompts
# CCBOT_SHOW_TOOL_CALLS=true

# Show hidden (dot) directories in browser (default: false)
# CCBOT_SHOW_HIDDEN_DIRS=false

# === Optional: behavior ===

# Idle reminder timeout in seconds (default: 120)
# CCBOT_IDLE_REMINDER_SECONDS=120

# Auto-restart Claude on crash (default: true)
# CCBOT_AUTO_RESTART=true

# File retention days for downloaded files (default: 7, 0 = disabled)
# CCBOT_FILE_RETENTION_DAYS=7

# Threshold for long response preview + file (default: 6000)
# CCBOT_LONG_RESPONSE_THRESHOLD=6000

# Input batching debounce in seconds (default: 1.5)
# CCBOT_INPUT_BATCH_SECONDS=1.5

# Custom Claude projects path (default: auto-detect)
# CCBOT_CLAUDE_PROJECTS_PATH=

# === Optional: paths ===

# Alternative Claude config directory (default: ~/.claude)
# CLAUDE_CONFIG_DIR=

# === Optional: legacy (scrubbed from env on startup) ===

# OpenAI API key — no longer used, but scrubbed from env to prevent leakage
# OPENAI_API_KEY=

# === Optional: WebSocket bridge ===

# Enable WebSocket bridge for web frontend (default: false)
# CCBOT_WS_ENABLED=false

# WebSocket server host and port (default: 127.0.0.1:8765)
# CCBOT_WS_HOST=127.0.0.1
# CCBOT_WS_PORT=8765

# Authentication token for WebSocket connections (required if WS enabled)
# CCBOT_WS_TOKEN=your_secure_token_here
