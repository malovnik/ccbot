# Telegram Bot Token (required)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed user IDs (comma-separated, required)
ALLOWED_USERS=123456789,987654321

# Tmux session name (optional, defaults to "ccbot")
TMUX_SESSION_NAME=ccbot

# Claude command to run in new windows (optional, defaults to "claude")
CLAUDE_COMMAND=claude

# Monitor polling interval in seconds (optional, defaults to 2.0)
MONITOR_POLL_INTERVAL=2.0

# CCBot config directory (optional, defaults to ~/.ccbot)
# CCBOT_DIR=~/.ccbot

# Show user messages with prefix in Telegram (optional, defaults to "true")
# CCBOT_SHOW_USER_MESSAGES=true

# Show tool_use/tool_result messages (optional, defaults to "true")
# CCBOT_SHOW_TOOL_CALLS=true

# Show hidden directories in directory browser (optional, defaults to "false")
# CCBOT_SHOW_HIDDEN_DIRS=false

# Auto-approve .claude/ self-edit permission prompts (optional, defaults to "true")
# Polls tmux panes every 2s and auto-confirms .claude/ permission dialogs
# CCBOT_AUTO_APPROVE=true

# Skip all permission prompts in Claude Code (optional, defaults to "true")
# When true, Claude Code runs with --dangerously-skip-permissions
# CCBOT_DANGEROUS_MODE=true

# OpenAI API key for voice transcription (optional, required for /voice)
# OPENAI_API_KEY=sk-...

# OpenAI API base URL (optional, defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Custom path to Claude projects directory (optional)
# CCBOT_CLAUDE_PROJECTS_PATH=~/.claude/projects

# Custom Claude config directory (optional)
# CLAUDE_CONFIG_DIR=~/.claude
